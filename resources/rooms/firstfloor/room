# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

IMAGE bg 0 0 0
END_IMAGE

IMAGE carpet_moved 181 151 0.3
	WHEN STATE_IS firstfloor_carpet_moved true
END_IMAGE

# ---------------------------------------------------------------------------
# Hotspots
# ---------------------------------------------------------------------------

HOTSPOT FIRSTFLOOR_LARGE_PAINTING 46 34 49 51
END_HOTSPOT

HOTSPOT FIRSTFLOOR_SMALL_PAINTING 68 160 25 29
END_HOTSPOT

HOTSPOT FIRSTFLOOR_LAMP 1 16 32 52
	USE SCREWDRIVER
		MESSAGE USE_SCREWDRIVER_WITH_LAMP
	END_USE
END_HOTSPOT

HOTSPOT FIRSTFLOOR_CARPET 229 165 82 46
	ACTION
		SET firstfloor_carpet_moved
	END_ACTION
END_HOTSPOT

