# Images
# ---------------------------------------------------------------------------

IMAGE background 0 0 0
END_IMAGE

IMAGE ring_taken 191 8 0.2
	WHEN INVENTORY_HAS RING true
END_IMAGE

IMAGE rope_taken 0 186 0.2
	WHEN STATE_IS underground_rope_taken true
END_IMAGE

