# ---------------------------------------------------------------------------
# Hotspots
# ---------------------------------------------------------------------------

HOTSPOT STUDY_SWITCH 127 47 16 15
	WHEN STATE_IS study_lights_on false
	ACTION
		WHEN STATE_IS study_lightbulb_screwed false
		MESSAGE STUDY_NO_LIGHTBULB
	END_ACTION
	ACTION
		WHEN STATE_IS study_lightbulb_screwed true
		SET study_lights_on
		MESSAGE STUDY_LIGHT
	END_ACTION
END_HOTSPOT

HOTSPOT STUDY_LAMP 120 61 29 20
	WHEN STATE_IS study_lights_on false
	USE LIGHTBULB
		INVENTORY_REMOVE LIGHTBULB
		SET study_lightbulb_screwed
		MESSAGE STUDY_USE_LIGHTBULB
	END_USE
	USE FLASHLIGHT
		MESSAGE STUDY_USE_FLASHLIGHT
	END_USE
END_HOTSPOT

HOTSPOT STUDY_DARK 0 0 320 240
	WHEN STATE_IS study_lights_on false
	MESSAGE STUDY_MESSAGE_NO_LIGHT
	USE FLASHLIGHT
		MESSAGE STUDY_DARK_USE_FLASHLIGHT
	END_USE
	USE LIGHTER
		MESSAGE STUDY_DARK_USE_LIGHTER
	END_USE
	USE *
		MESSAGE STUDY_USE_NO_LIGHT
	END_USE
END_HOTSPOT

