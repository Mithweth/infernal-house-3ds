#include <citro2d.h>

#include "game.h"
#include "room.h"
#include "room_gfx.h"
#include "room_gfx_t3x.h"
#include "inventory.h"
#include "hall.h"

static C2D_SpriteSheet room_scene;
static C2D_Image img_background;

static Hotspot hotspots[] = {};

static void room_init(void) {
    room_scene = C2D_SpriteSheetLoadFromMem(room_gfx_t3x, room_gfx_t3x_size);
    img_background = C2D_SpriteSheetGetImage(room_scene, room_gfx_bg_idx);
}

static void room_draw(void) {
    C2D_DrawImageAt(img_background, 0.0f, 0.0f, 0.0f, NULL, 1.0f, 1.0f);
}

static void room_close(void) {
    C2D_SpriteSheetFree(room_scene);
}

Room dining_room = {
    .hotspots = hotspots,
    .hotspot_count = sizeof(hotspots) / sizeof(hotspots[0]),
    .up = NULL,
    .down = NULL,
    .left = NULL,
    .right = NULL,
    .init = room_init,
    .draw = room_draw,
    .close = room_close
};